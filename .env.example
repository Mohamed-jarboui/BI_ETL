# MongoDB (operational database)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=ecommerce

# PostgreSQL (data warehouse) - local development values, change them for any shared setup
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ecommerce_dw
PG_USER=bi_admin
PG_PASSWORD=change_me
# DATABASE_URL=postgresql://user:password@host:5432/dbname   # optional, overrides the PG_* values

# ETL
BATCH_SIZE=1000
LOG_LEVEL=INFO
